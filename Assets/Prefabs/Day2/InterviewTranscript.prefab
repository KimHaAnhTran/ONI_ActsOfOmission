  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "I would like to say just a word about the Philippine and Cuban business:\r\n(1)
    We could <i>not</I> give Cuba back to Spain\u2014that would be cowardly and dishonorable\r.\n(2)
    We could <I>not</i> turn the Filipinos over to France or Germany, our commercial
    rivals in the Orient.\r\n(3) We could <i>not</i> leave them to themselves\u2014they
    were unfit for self-governance.\r\n(4) We, therefore, must educate them, uplift,
    civilize, and Christianize them.\r\nThe Philippines will stay on the map of the
    United States. And there it will stay while I am President!\r\n"
  m_isRightToLeft: 0
