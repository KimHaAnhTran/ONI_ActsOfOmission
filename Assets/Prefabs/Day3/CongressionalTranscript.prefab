  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "To suggest we must enter this Eruopean war for the sake of morality is
    the height of hypocrisy. \r\nLet us not forget the occupation of Veracruz. We
    claimed to invade to \"protect democracy,\" yet no news has come out of this
    \u201CGerman ship\u201D unloading ammunition on Mexican shores. Are we so blind
    as to not see this as a maneuver to undermine a government that refused to bow
    to American interests?\nHeed Washington\u2019s words: let us not intervene in
    foreign affairs! We must not sacrifice more American lives."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 95c44eae1d048a744a5f90acb05550f4, type: 2}
  m_sharedMaterial: {fileID: -1414496702158017081, guid: 95c44eae1d048a744a5f90acb05550f4, type: 2}
